{
  "name": "papyrus",
  "version": "0.8.1",
  "description": "Embedded code editor leveraging PrismJS",
  "author": {
    "name": "Νίκος Σαβίδης",
    "email": "n.savvidis@gmx.com"
  },
  "license": "MIT",
  "types": "./index.d.ts",
  "main": "./dist/node.cjs.js",
  "module": "./dist/node.esm.js",
  "browser": {
    "./dist/node.cjs.js": "./dist/browser.cjs.js",
    "./dist/node.esm.js": "./dist/browser.esm.js"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "browser": "./dist/browser.esm.js",
      "import": "./dist/node.esm.js",
      "require": "./dist/node.cjs.js"
    },
    "./theme": {
      "types": "./theme.d.ts",
      "import": "./dist/theme.esm.js",
      "require": "./dist/theme.cjs.js"
    },
    "./papyrus.css": "./dist/papyrus.css",
    "./themes/*": "./dist/themes/*",
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "private": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/panoply/papyrus"
  },
  "bugs": {
    "url": "https://github.com/panoply/papyrus/issues"
  },
  "scripts": {
    "dev": "concurrently \"tsup --watch\" \"node --watch-path=src/theme --watch-path=src/styles --watch-path=scripts scripts/css.ts\"",
    "build": "rm -rf dist && tsup --minify --env.NODE_ENV production && node scripts/css.ts --minify && gzip-size dist/browser.esm.js --include-original",
    "pack": "cd versions; pnpm pack ../ && cd ..",
    "css": "node scripts/css.ts"
  },
  "stylelint": {
    "extends": "@sissel/stylelint-config",
    "ignoreFiles": [
      "public",
      "node_modules"
    ]
  },
  "prettier": "@sissel/prettier-config",
  "eslintConfig": {
    "ignorePatterns": [
      "dist/*"
    ],
    "rules": {
      "n/no-callback-literal": "off"
    },
    "extends": [
      "@sissel/eslint-config"
    ]
  },
  "devDependencies": {
    "@sissel/eslint-config": "^1.2.1",
    "@sissel/prettier-config": "^1.2.5",
    "@sissel/stylelint-config": "^1.2.4",
    "ava": "^6.1.3",
    "concurrently": "^10.0.3",
    "esbuild": "0.23.1",
    "eslint": "~9.9.0",
    "lz-string": "^1.5.0",
    "prism-code-editor": "^3.4.0",
    "terser": "^5.31.6",
    "tsup": "8.3.0",
    "type-fest": "^4.25.0"
  }
}
