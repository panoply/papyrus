{
  "name": "papyrus",
  "version": "0.6.3",
  "description": "Embedded code editor leveraging PrismJS",
  "author": {
    "name": "Νίκος Σαβίδης",
    "email": "n.savvidis@gmx.com"
  },
  "license": "MIT",
  "types": "./index.d.ts",
  "main": "./dist/node.cjs.js",
  "module": "./dist/node.esm.js",
  "browser": {
    "./dist/node.cjs.js": "./dist/browser.cjs.js",
    "./dist/node.esm.js": "./dist/browser.esm.js"
  },
  "private": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/panoply/papyrus"
  },
  "bugs": {
    "url": "https://github.com/panoply/papyrus/issues"
  },
  "scripts": {
    "dev": "concurrently \"pnpm run scss:dev\" \"tsup --watch\" \"cd docs; pnpm run dev; cd ..;\"",
    "build": "rm -rf dist && pnpm run scss:build && tsup --minify --env.NODE_ENV production && gzip-size dist/browser.esm.js --include-original",
    "scss:dev": "sass ./index.scss:./docs/public/papyrus.css --watch",
    "scss:build": "sass ./index.scss:./papyrus.css --no-source-map --style=compressed",
    "pack": "cd versions; pnpm pack ../ && cd .."
  },
  "stylelint": {
    "extends": "@sissel/stylelint-config",
    "ignoreFiles": [
      "public",
      "node_modules"
    ]
  },
  "prettier": "@sissel/prettier-config",
  "eslintConfig": {
    "ignorePatterns": [
      "dist/*"
    ],
    "rules": {
      "n/no-callback-literal": "off"
    },
    "extends": [
      "@sissel/eslint-config"
    ]
  },
  "devDependencies": {
    "@sissel/eslint-config": "^1.2.1",
    "@sissel/prettier-config": "^1.2.5",
    "@sissel/stylelint-config": "^1.2.4",
    "ava": "^6.1.3",
    "eslint": "~8.56.0",
    "lz-string": "^1.5.0",
    "prism-code-editor": "^3.3.3",
    "sass": "^1.77.8",
    "terser": "^5.31.2",
    "type-fest": "^4.21.0"
  },
  "dependencies": {
    "calculate-size": "^1.1.1"
  }
}
